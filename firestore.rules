rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Staff-only app: anyone signed in to the Firebase project can read/write.
    // If you later add a public read-only catalog page, split that into its
    // own rules path instead of loosening this one.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
